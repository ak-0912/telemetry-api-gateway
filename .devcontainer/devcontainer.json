{
  "name": "telemetry-api-gateway",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "API (host; app listens on :8080 in container)"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
